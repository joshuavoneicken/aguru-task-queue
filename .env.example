# Only needed when port 5432 is already taken: `cp .env.example .env` moves both knobs to 5433.
# Without a .env, `npm start` defaults both to 5432 (see scripts/dev.sh).
POSTGRES_PORT=5433
DATABASE_URL=postgres://queue:queue@localhost:5433/queue
QUEUES_FILE=queues.json

# Everything below is optional; the values shown are the defaults.

# API process
# PORT=3000                              # the worker also reads it, to derive its default API_URL
# UI_ORIGIN=http://localhost:5173        # CORS origin for the Vite dev server; unused when the API serves the built UI
# ALLOWED_HOSTS=                          # comma-separated public hostnames accepted by the Host guard; loopback always is

# Worker process (read by the worker only)
# API_URL=http://localhost:3000            # defaults to http://localhost:<PORT>; a path prefix is kept
# QUEUE_NAME=jobs
# WORKER_ID=                              # defaults to a random worker-xxxxxxxx per start
# CONCURRENCY=4

# Leases and execution budget (SHUTDOWN_GRACE_MS is read by the worker only)
# LEASE_MS=30000
# SHUTDOWN_GRACE_MS=25000                 # must stay below LEASE_MS; defaults to 5/6 of it, capped at 25000
# MAX_TASK_EXECUTION_MS=300000

# Bounds on caller-controlled sizes
# PAYLOAD_MAX_BYTES=262144
# RESULT_MAX_BYTES=262144
# CLAIM_MAX_LIMIT=100

# http handler (worker only)
# HTTP_REDIRECT_MAX=5
# ALLOW_LOOPBACK_HTTP=false               # opens the SSRF guard to localhost for local demos only; never set in a deployment

# Policy for queues created implicitly on first enqueue. Queues named in QUEUES_FILE use their own.
# QUEUE_MAX_ATTEMPTS=5
# QUEUE_BACKOFF_BASE_MS=3000
# QUEUE_BACKOFF_CAP_MS=300000
# QUEUE_DEDUPE_WINDOW_MS=600000
