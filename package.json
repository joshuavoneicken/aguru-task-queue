{
  "name": "aguru-task-queue",
  "private": true,
  "type": "module",
  "workspaces": [
    "harness"
  ],
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "start": "npm install --no-audit --no-fund && npm run dev:full",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "migrate": "tsx scripts/migrate.ts",
    "dev:api": "tsx src/bin/api.ts",
    "dev:worker": "tsx src/bin/worker.ts",
    "dev": "bash scripts/dev.sh",
    "dev:full": "npm run ui:build && npm run dev",
    "ui": "npm --prefix ui run dev",
    "ui:build": "npm --prefix ui install --no-audit --no-fund && npm --prefix ui run build",
    "ui:test": "npm --prefix ui test"
  },
  "dependencies": {
    "@aguru/harness": "*",
    "@fastify/cors": "^10.1.0",
    "@fastify/static": "^8.3.0",
    "fastify": "^5.0.0",
    "pg": "^8.13.0",
    "undici": "^7.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@vitest/coverage-v8": "^3.2.7",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
